{
  "compilerOptions": {
    "target": "es2016",
    "module": "CommonJS",
    "lib": ["ES2021"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": "./src"
  },
  "include": ["src", "src/types"],
  "exclude": ["node_modules"]
}
